{
  "functions": {
    "api/live.mjs": { "maxDuration": 120 }
  },
  "rewrites": [{ "source": "/__lookluxe/decart/status", "destination": "/api/live" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=()" }]
    }
  ]
}
