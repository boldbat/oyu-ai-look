# Direct Decart pitch MVP. Copy this file to .env.local and set the key there.
# These values are read only by the Node/Vite server, never the browser bundle.
DECART_API_KEY=
DECART_MODEL=lucy-vton-3.6

# Optional existing Oyu AI account API root, without /v1.
# Direct Live try-on does not need this API or a Oyu AI account.
# Example: LOOKLUXE_API_ORIGIN=http://127.0.0.1:8000
LOOKLUXE_API_ORIGIN=

# Local pitch defaults: loopback only, one active Decart session.
# Remote demos need private access in front of this unauthenticated gateway.
# DECART_DEMO_ALLOW_REMOTE=true
# PUBLIC_WEB_ORIGIN=https://oyu.example
# HOST=0.0.0.0
# PORT=5174

# Legacy VITE_API_BASE_URL remains supported as a fallback upstream origin.
# Never put credentials, tokens, or provider keys in VITE_ variables.
