# Direct Decart pitch MVP. Copy this file to .env.local and set the key there.
# These values are read only by the Node/Vite server, never the browser bundle.
DECART_API_KEY=
DECART_MODEL=lucy-vton-3.6

# Oyu's human voice (optional). Without a key she uses the browser's own voice.
# Only her spoken lines are sent to ElevenLabs. Loopback only unless allowed below.
ELEVENLABS_API_KEY=
# Optional default voice id; otherwise a warm female voice from your account.
# ELEVENLABS_VOICE_ID=
# Optional model; otherwise eleven_v4_turbo, then eleven_v4, then eleven_v3.
# ELEVENLABS_MODEL=
# ELEVENLABS_ALLOW_REMOTE=true

# Optional existing Oyu AI account API root, without /v1.
# Local Live try-on does not need this API or an Oyu AI account.
# Example: LOOKLUXE_API_ORIGIN=http://127.0.0.1:8000
LOOKLUXE_API_ORIGIN=

# Live sessions have no time limit by default and run until Stop or until the tab is
# hidden. Set a number of seconds (minimum 10) to cap every session.
# DECART_MAX_SESSION_SECONDS=
# Decart fast mode: lower latency and higher throughput at 2x the per-second price.
# DECART_SPEED=fast

# Local pitch defaults: loopback only, one active Decart session.
# Remote demos need private access in front of this unauthenticated gateway.
# DECART_DEMO_ALLOW_REMOTE=true
# PUBLIC_WEB_ORIGIN=https://oyu.example
# HOST=0.0.0.0
# PORT=5174

# Legacy VITE_API_BASE_URL remains supported as a fallback upstream origin.
# Never put credentials, tokens, or provider keys in VITE_ variables.

# Firebase Google sign-in and cloud preferences use the public browser config
# in src/lib/firebase-web-config.json. No Firebase admin credential is needed.

# Vercel live function: set these in Vercel's server environment, alongside
# DECART_API_KEY and DECART_MODEL above. Never prefix them with VITE_.
# The function verifies Firebase Google ID tokens before contacting Decart.
# FIREBASE_PROJECT_ID=oyu-i-look
# LIVE_ALLOWED_EMAILS=your-authorized-google-email@example.com
# LIVE_ALLOWED_ORIGINS=https://your-project.vercel.app
